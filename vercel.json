{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/vsl",
      "destination": "/vsl.html"
    },
    {
      "source": "/booked",
      "destination": "/booked.html"
    },
    {
      "source": "/not-a-fit",
      "destination": "/not-a-fit.html"
    }
  ],
  "headers": [
    {
      "source": "/(vsl|booked|not-a-fit)(.html)?",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(vsl|proof|tools|badges)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/vsl",
      "permanent": false
    }
  ]
}
